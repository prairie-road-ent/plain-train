FROM mcr.microsoft.com/devcontainers/base:ubuntu
USER vscode
ENV PROJECT_DIRECTORY_PATH=/workspaces/plain-train
ENV OUTPUT_DIRECTORY_PATH=${PROJECT_DIRECTORY_PATH}/out
ENV OUTPUT_INCLUDE_DIRECTORY_PATH=${OUTPUT_DIRECTORY_PATH}/include
ENV OUTPUT_BINARY_PATH=${OUTPUT_DIRECTORY_PATH}/plain-train
ENV OUTPUT_LIBRARY_PATH=${OUTPUT_DIRECTORY_PATH}/libplain-train.so
ENV INSTALL_DIRECTORY_PATH=/usr/local
ENV INSTALL_BINARY_PATH=${INSTALL_DIRECTORY_PATH}/bin/plain-train
ENV INSTALL_LIBRARY_PATH=${INSTALL_DIRECTORY_PATH}/lib/libplain-train.so
ENV INSTALL_INCLUDE_DIRECTORY_PATH=${INSTALL_DIRECTORY_PATH}/include
ENV DEPENDENCIES_DIRECTORY_PATH=${PROJECT_DIRECTORY_PATH}/dependencies
ENV SOURCE_DIRECTORY_PATH=${PROJECT_DIRECTORY_PATH}/source
ENV MAIN_SOURCE_FILE_PATH=${SOURCE_DIRECTORY_PATH}/main.c
COPY ./scripts/installBuildTools.sh /tmp
RUN bash ./tmp/installBuildTools.sh
RUN sudo rm /tmp/installBuildTools.sh
